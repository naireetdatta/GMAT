# ============================================
# GMAT Platform Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://gmat:gmat_password@localhost:5432/gmat_platform?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (NextAuth.js v5)
AUTH_SECRET="generate-a-random-secret-here"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# AI Models
AI_DEEPSEEK_API_KEY=""
AI_DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
AI_DEEPSEEK_MODEL="deepseek-chat"

AI_NEMOTRON_API_KEY=""
AI_NEMOTRON_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_NEMOTRON_MODEL="nvidia/nemotron-ultra"

AI_GLM_API_KEY=""
AI_GLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
AI_GLM_MODEL="glm-4-plus"

AI_KIMI_API_KEY=""
AI_KIMI_BASE_URL="https://api.moonshot.cn/v1"
AI_KIMI_MODEL="moonshot-v1-128k"

AI_BGE_API_KEY=""
AI_BGE_BASE_URL=""
AI_BGE_MODEL="bge-m3"

# Fallback Models
AI_OPENAI_API_KEY=""
AI_GEMINI_API_KEY=""
AI_CLAUDE_API_KEY=""
AI_OLLAMA_BASE_URL="http://localhost:11434"

# Model Assignment (which model handles which task)
AI_QUESTION_GENERATION_PROVIDER="deepseek"
AI_VALIDATION_PROVIDER="nemotron"
AI_EXPLANATION_PROVIDER="glm"
AI_TUTOR_PROVIDER="kimi"
AI_EMBEDDING_PROVIDER="bge"

# Application
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000

# Storage (local filesystem for now)
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./storage"
