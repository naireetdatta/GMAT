# ============================================
# GMAT Platform Environment Variables
# ============================================

# Database (Supabase PostgreSQL)
# Transaction pooler (Port 6543) for runtime queries:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (Port 5432) for Prisma migrations and schema push:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (NextAuth.js v5)
AUTH_SECRET="generate-a-random-secret-here"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Vector Database (Externalized to Supabase pgvector)
VECTOR_PROVIDER="pgvector"
# Optional legacy Qdrant fallback (disabled)
# QDRANT_URL=""
# QDRANT_API_KEY=""

# Cloud AI Models (100% External — No Local Models)
# NVIDIA NIM (Free 1000 credits at https://build.nvidia.com)
AI_NVIDIA_API_KEY=""
AI_NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_NVIDIA_MODEL="deepseek-ai/deepseek-r1"

# NVIDIA Nemotron (for strict 7-point psychometric validation)
AI_NEMOTRON_API_KEY=""
AI_NEMOTRON_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_NEMOTRON_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# NVIDIA NIM Embeddings (baai/bge-m3 or nvidia/nv-embedqa-e5-v5)
AI_BGE_API_KEY=""
AI_BGE_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_BGE_MODEL="baai/bge-m3"

# Google Gemini (Free tier available at https://aistudio.google.com)
AI_GEMINI_API_KEY=""
AI_GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_GEMINI_MODEL="gemini-2.0-flash"

# OpenAI
AI_OPENAI_API_KEY=""
AI_OPENAI_BASE_URL="https://api.openai.com/v1"
AI_OPENAI_MODEL="gpt-4o-mini"

# DeepSeek Native API (https://platform.deepseek.com)
AI_DEEPSEEK_API_KEY=""
AI_DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
AI_DEEPSEEK_MODEL="deepseek-chat"

# Anthropic Claude
AI_CLAUDE_API_KEY=""

# Model Assignment (Select which provider handles which role)
# Options: "nvidia", "nemotron", "gemini", "openai", "deepseek", "bge"
AI_QUESTION_GENERATION_PROVIDER="nvidia"
AI_VALIDATION_PROVIDER="nemotron"
AI_EXPLANATION_PROVIDER="nvidia"
AI_TUTOR_PROVIDER="nvidia"
AI_EMBEDDING_PROVIDER="bge"

# Application
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000

# Storage (local filesystem for now)
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./storage"
