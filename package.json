{
  "name": "gmat-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered GMAT Focus Edition Preparation Platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @gmat/database generate",
    "db:migrate": "pnpm --filter @gmat/database migrate:dev",
    "db:push": "pnpm --filter @gmat/database push",
    "db:seed": "pnpm --filter @gmat/database seed",
    "db:studio": "pnpm --filter @gmat/database studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
